# StormReady Phase 1 runs anonymously with no required secrets.
# Copy to .env.local only if you start wiring later services.

# --- Later / optional: Auth0 (not used to build; wiring is a later PR) ---
# AUTH0_SECRET=
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# --- Optional: Supabase Save My Plan ---
# Live save/restore is gated on these two. The app builds without them.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Use after Auth0 has verified the user `sub`. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Dev-only identity bypass for /api/save-plan and /api/load-plan.
# Ignored when NODE_ENV=production. Requires the header x-stormready-dev-sub.
# ALLOW_SAVE_PLAN_DEV_BYPASS=1

# --- Later / optional: Mapbox / Places (Map tab is a placeholder) ---
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_MAPBOX_STYLE=

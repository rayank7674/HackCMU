# StormReady runs anonymously with no required secrets.
# Copy to .env.local to enable Auth0 login and Supabase Save My Plan.

# --- Auth0 (optional — build succeeds without these) ---
# AUTH0_SECRET=
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=https://YOUR_DOMAIN
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# v4 aliases (optional if the names above are set):
# AUTH0_DOMAIN=
# APP_BASE_URL=http://localhost:3000

# Auth0 application URLs to verify:
#   Allowed Callback URLs:
#     http://localhost:3000/api/auth/callback
#     https://YOUR_VERCEL_DOMAIN/api/auth/callback
#   Allowed Logout URLs:
#     http://localhost:3000
#     https://YOUR_VERCEL_DOMAIN
#   Allowed Web Origins:
#     http://localhost:3000
#     https://YOUR_VERCEL_DOMAIN

# --- Supabase Save My Plan (optional — build succeeds without these) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Use after Auth0 has verified the user `sub`. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Dev-only identity bypass for /api/save-plan and /api/load-plan.
# Ignored when NODE_ENV=production. Requires the header x-stormready-dev-sub.
# ALLOW_SAVE_PLAN_DEV_BYPASS=1

# --- Optional: Mapbox tiles (Map uses Leaflet + OpenStreetMap by default) ---
# The Map tab works with no token. If set, Leaflet loads Mapbox tiles instead.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12
# Places / contractor ranking is not used.

# --- Optional: Ask StormReady / Read My Plan / K2 inspect (Lane D) ---
# All fail closed when unset. Never invents safety policy, alerts, or a K2 host.
# XAI_API_KEY=
# ELEVENLABS_API_KEY=
# K2_API_KEY=
# K2_API_BASE_URL=
# K2_MODEL=
